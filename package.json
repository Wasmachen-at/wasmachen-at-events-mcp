{
  "name": "wasmachen-events-mcp",
  "version": "1.0.3",
  "description": "MCP server for searching wasmachen.at events from ChatGPT, Claude, and other MCP clients",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "chatgpt",
    "claude",
    "events",
    "wasmachen",
    "austria"
  ],
  "homepage": "https://mcp.wasmachen.at",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wasmachen-at/mcp-page.git"
  },
  "bugs": {
    "url": "https://github.com/Wasmachen-at/mcp-page/issues"
  },
  "license": "MIT",
  "author": {
    "name": "wasmachen.at",
    "email": "support@wasmachen.at",
    "url": "https://wasmachen.at"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "wasmachen-events-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "WASMACHEN_API_URL=${WASMACHEN_API_URL:-http://localhost:3001} tsx watch src/index.ts",
    "dev:stdio": "WASMACHEN_API_URL=${WASMACHEN_API_URL:-http://localhost:3001} tsx src/cli.ts",
    "build": "npm run build:widget && tsc -p tsconfig.json",
    "build:widget": "node scripts/build-widget.mjs",
    "start": "WASMACHEN_API_URL=${WASMACHEN_API_URL:-http://localhost:3001} node dist/src/index.js",
    "start:stdio": "WASMACHEN_API_URL=${WASMACHEN_API_URL:-http://localhost:3001} node dist/src/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "maplibre-gl": "^6.0.0",
    "preact": "^10.29.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

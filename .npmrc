# Supply-chain cooldown: whenever npm resolves versions (npm install, npm update,
# npx, Dependabot), it only picks versions published at least 7 days ago.
# Most hijacked releases are found and pulled within hours.
# npm ci installs the lockfile as-is and is not affected. Needs npm >= 11.10
# (bundled with Node 24); older npm ignores the setting.
# Urgent fix that is newer than 7 days: npm install <pkg>@<version> --min-release-age=0
min-release-age=7
